---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteShuffle from '../components/QuoteShuffle';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="hero-section">
				<div class="hero-copy">
					<span class="eyebrow">你好，我是 Shane（谢恩）</span>
					<h1>在代码与文字之间，<br /><span>记录有意思的事。</span></h1>
					<p>前端、后端、工具与生活随想。把偶然学到的东西，整理成可以再次打开的记忆。</p>
					<QuoteShuffle client:load />
					<div class="hero-actions">
						<a class="primary-button" href="/blog">阅读文章 <span aria-hidden="true">→</span></a>
						<a class="text-button" href="/about">认识一下</a>
					</div>
				</div>
				<div class="profile-card">
					<div class="profile-glow"></div>
					<img src="https://github.com/shane0413.png" alt="Shane 的头像" width="180" height="180" />
					<div class="profile-status"><span></span> 开启记录</div>
				</div>
			</section>

			<section class="contact-strip" aria-label="联系方式">
				<a href="mailto:shane00413@gmail.com"><span>邮箱</span><strong>shane00413@gmail.com</strong></a>
				<a href="https://t.me/shane_0413" target="_blank"><span>Telegram</span><strong>@shane_0413</strong></a>
				<a href="https://github.com/shane0413" target="_blank"><span>GitHub</span><strong>@shane0413</strong></a>
				<div><span>QQ</span><strong>3514143296</strong></div>
			</section>

			<section class="latest-section">
				<div class="section-heading">
					<div>
						<span class="eyebrow">最新内容</span>
						<h2>最近的文章</h2>
					</div>
					<a href="/blog">查看全部 <span aria-hidden="true">→</span></a>
				</div>
				<div class="latest-grid">
					{posts.map((post) => (
						<article>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<img src={post.data.heroImage.src} alt="" width="720" height="360" />
								)}
								<div class="latest-meta">
									<span>{post.data.category || '随笔'}</span>
									<time><FormattedDate date={post.data.pubDate} /></time>
								</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						</article>
					))}
				</div>
			</section>

			<section class="friends-section">
				<div class="section-heading">
					<div>
						<span class="eyebrow">友邻站点</span>
						<h2>友情链接</h2>
					</div>
				</div>
				<div class="friends-grid">
					<a href="https://github.com/" target="_blank" rel="noreferrer">
						<span>G</span><div><strong>GitHub</strong><small>全球开发者社区</small></div>
					</a>
					<a href="https://astro.build/" target="_blank" rel="noreferrer">
						<span>A</span><div><strong>Astro</strong><small>内容驱动的网站框架</small></div>
					</a>
					<a href="https://telegram.org/" target="_blank" rel="noreferrer">
						<span>T</span><div><strong>Telegram</strong><small>即时、开放与快速</small></div>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
