---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const post of posts) {
  const category = post.data.category || '随笔';
  counts.set(category, (counts.get(category) || 0) + 1);
}
const categories = [...counts.entries()].sort((a,b) => b[1]-a[1]);
---
<!doctype html>
<html lang="zh-CN"><head><BaseHead title={`文章分类 · ${SITE_TITLE}`} description="按主题浏览 Shane 的文章。" /></head>
<body><Header /><main class="content-main">
<header class="page-heading"><span class="eyebrow">CONTENT / CATEGORIES</span><h1>文章分类</h1><p>按主题整理内容，让每一次查找都更直接。</p></header>
<div class="taxonomy-grid">{categories.map(([category,count]) => <a class="taxonomy-card" href={`/categories/${encodeURIComponent(category)}/`}><strong>{category}</strong><span>{count} 篇文章　→</span></a>)}</div>
</main><Footer /></body></html>
