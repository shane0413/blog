---
const today = new Date();
---

<footer>
	<div>
		<strong>shane's blog</strong>
		<span>© {today.getFullYear()} Shane（谢恩）</span>
	</div>
	<div class="footer-links">
		<a href="mailto:shane00413@gmail.com">邮件</a>
		<a href="https://t.me/shane_0413" target="_blank" rel="noreferrer">Telegram</a>
		<a href="https://github.com/shane0413" target="_blank" rel="noreferrer">GitHub</a>
	</div>
</footer>

<style>
	footer {
		display: flex;
		width: min(1120px, calc(100% - 40px));
		margin: 0 auto;
		padding: 28px 0 40px;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid rgba(29, 29, 31, 0.08);
		color: #86868b;
		font-size: 13px;
	}
	div:first-child {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	strong {
		color: #1d1d1f;
	}
	.footer-links {
		display: flex;
		gap: 20px;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	a:hover {
		color: #1d1d1f;
	}
	@media (max-width: 720px) {
		footer {
			flex-direction: column;
			align-items: flex-start;
			gap: 18px;
		}
	}
</style>
