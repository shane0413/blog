---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../utils/paths';

type Props = HTMLAttributes<'a'> & { href: string };
const { href, class: className, ...props } = Astro.props;
const target = withBase(href);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '') || '/';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const targetPath = new URL(target, Astro.url).pathname.replace(/\/+$/, '') || '/';
const isHomeLink = href === '/';
const isBlogArchive = targetPath.endsWith('/blog') && currentPath.startsWith(`${targetPath}/archive`);
const archiveBase = `${basePath}/blog/archive`.replace(/^\/\//, '/');
const isArchivePage = targetPath.endsWith('/archive') && currentPath.startsWith(archiveBase);
const isActive = isHomeLink
  ? currentPath === basePath
  : isArchivePage || (!isBlogArchive && (currentPath === targetPath || currentPath.startsWith(`${targetPath}/`)));
---
<a
  href={target}
  class:list={[className, { active: isActive }]}
  aria-current={isActive ? 'page' : undefined}
  {...props}
>
  <slot />
</a>
