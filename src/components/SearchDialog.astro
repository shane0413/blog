---
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		title: post.data.title,
		description: post.data.description,
		href: `/blog/${post.id}/`,
		category: post.data.category || '随笔',
	}));
---

<button class="search-trigger" type="button" aria-label="搜索文章" title="搜索文章">
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
	</svg>
	<span>搜索</span>
</button>
<dialog class="search-dialog" aria-label="搜索文章">
	<form method="dialog" class="search-shell">
		<div class="search-field">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
			</svg>
			<input type="search" placeholder="搜索标题、描述或分类…" autocomplete="off" />
			<button value="cancel" aria-label="关闭搜索">ESC</button>
		</div>
		<div class="search-results"></div>
	</form>
</dialog>

<script define:vars={{ posts }}>
	const trigger = document.querySelector('.search-trigger');
	const dialog = document.querySelector('.search-dialog');
	const input = dialog?.querySelector('input');
	const results = dialog?.querySelector('.search-results');

	const render = (query = '') => {
		const needle = query.trim().toLowerCase();
		const matches = posts.filter((post) =>
			`${post.title} ${post.description} ${post.category}`.toLowerCase().includes(needle),
		).slice(0, 8);
		results.innerHTML = matches.length
			? matches.map((post) => `
				<a href="${post.href}">
					<span>${post.category}</span>
					<div><strong>${post.title}</strong><small>${post.description}</small></div>
					<i>→</i>
				</a>`).join('')
			: '<p class="search-empty">没有找到相关文章</p>';
	};

	trigger?.addEventListener('click', () => {
		dialog.showModal();
		input.value = '';
		render();
		requestAnimationFrame(() => input.focus());
	});
	input?.addEventListener('input', () => render(input.value));
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
</script>
